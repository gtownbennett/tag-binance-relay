# Core protected relay
RELAY_TOKEN=replace-with-a-long-random-value
ADMIN_KEY=replace-with-a-different-long-random-admin-value

# Emergency cost containment. Missing flags are safe/off by design.
REPAIR_MODE=true
LIVE_COLLECTORS_ENABLED=false
BACKFILL_ENABLED=false
PAID_AI_ENABLED=false
OPENAI_AUTOMATIC_ENABLED=false
CHAD_REACTIVATION_ENABLED=false
CHAD_KILL_SWITCH=true
CHAD_FORECAST_WRITES_ENABLED=false
CHAD_GRADING_ENABLED=false
CHAD_CACHE_WRITES_ENABLED=false
OPENAI_PROJECT_BUDGET_CONFIRMED=false
PUSH_ENABLED=false

# Hard in-relay circuit breakers. Provider billing limits remain the final cap.
OPENAI_DAILY_CALL_LIMIT=3
OPENAI_MONTHLY_CALL_LIMIT=30
OPENAI_AUTO_RESERVE_DAILY=1
OPENAI_AUTO_RESERVE_MONTHLY=4
OPENAI_AUTO_EVENT_COOLDOWN_SECONDS=21600
OPENAI_AUTO_MIN_CONFIRMATIONS=2
EXTERNAL_DAILY_REQUEST_LIMIT=250
EXTERNAL_MONTHLY_REQUEST_LIMIT=5000
EXPENSIVE_ROUTE_DAILY_LIMIT=250
EXPENSIVE_ROUTE_MONTHLY_LIMIT=5000
MANUAL_REFRESH_DAILY_LIMIT=25
MANUAL_REFRESH_MONTHLY_LIMIT=500
DATABASE_DAILY_QUERY_LIMIT=200000
DATABASE_MONTHLY_QUERY_LIMIT=6200000

# Durable PostgreSQL history. Render's DATABASE_URL is also accepted.
TERMINAL_DATABASE_URL=postgresql://user:password@host/database
# Optional explicit ledger URL. When omitted, the legacy ledger automatically uses
# TERMINAL_DATABASE_URL instead of temporary /tmp storage.
LEDGER_DATABASE_URL=

# OpenAI Chad
OPENAI_API_KEY=replace-with-your-private-project-key
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_TIMEOUT_SECONDS=75

# Read-only Cost & Usage reconciliation. All credentials remain server-side.
# The OpenAI Admin key is distinct from the application API key and its refresh
# stays explicitly off until invoice reconciliation is intentionally enabled.
COST_USAGE_REFRESH_INTERVAL_SECONDS=86400
COST_USAGE_MANUAL_MIN_SECONDS=300
GITHUB_BILLING_USER=
GITHUB_BILLING_TOKEN=
OPENAI_ADMIN_KEY=
COST_USAGE_OPENAI_REFRESH_ENABLED=false
# Optional dashboard-verified snapshots, keyed by github/render/neon/openai/codex.
COST_USAGE_PROVIDER_OVERRIDES_JSON=

# Durable forecast ledger and automatic grading
LEDGER_ENABLED=true
LEDGER_DB_PATH=/tmp/tag_prediction_ledger.sqlite3
LEDGER_BACKUP_PATH=/tmp/tag_prediction_ledger.sqlite3.backup.json
LEDGER_AUTO_BACKUP=true
LEDGER_AUTO_GRADE_SECONDS=300
LEDGER_DEADBAND_PCT=1.0
LEDGER_MAX_RECORDS=5000

# Exact CoinMarketCap Community post timestamps and optional quote comparison.
# The official Content and historical-quote endpoints require an eligible paid CMC plan.
CMC_PRO_API_KEY=
CMC_TAG_ID=
CMC_POLL_SECONDS=900

# TAG paper futures simulator — no real funds, no exchange login, no wallet signing.
PAPER_STARTING_BALANCE=10000
PAPER_FIRST_20_MAX_LEVERAGE=5
PAPER_MAX_LEVERAGE=5
PAPER_FEE_BPS=6
PAPER_MAINTENANCE_MARGIN_RATE=0.005

# Collector and data-quality controls
COLLECT_SECONDS=300
CACHE_SECONDS=60
TERMINAL_RESPONSE_CACHE_SECONDS=300
FRESHNESS_WARN_SECONDS=90
FRESHNESS_STALE_SECONDS=300
